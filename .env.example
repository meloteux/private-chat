# Environment variables for private-chat application
# Copy to .env and replace with your values

# Server configuration
PORT=3000
NODE_ENV=production

# Session secret - generates random one if not set
SESSION_SECRET=

# Database
# SQLite database file (optional - using default chat.db)
# DB_PATH=chat.db

# File upload limits
MAX_FILE_SIZE=25000000

# Security
# Set to true for HTTPS cookies in production
# SECURE_COOKIES=true

# Server configuration
# HOST=0.0.0.0

# Log level (optional)
# LOG_LEVEL=info

# Rate limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100